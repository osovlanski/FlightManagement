<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>FlightAlertManagement.Api</RootNamespace>
        <!-- UseWebRoot is optional, only needed if you serve static files -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FlightAlertManagement.Services\FlightAlertManagement.Services.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Resources\DataStructures\alert.json" />
      <_ContentIncludedByDefault Remove="Resources\DataStructures\notification.json" />
      <_ContentIncludedByDefault Remove="Resources\DataStructures\price.json" />
      <_ContentIncludedByDefault Remove="Resources\DataStructures\user.json" />
    </ItemGroup>
</Project>
